# ─── SAVORIA PRODUCTION ENVIRONMENT ─────────────────────────────
# Copy this file to .env.production and fill in real values.
# NEVER commit real secrets to version control.

# ─── Core ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
# Public URLs — replace with your real domains
APP_URL=https://www.savoria.app
API_URL=https://api.savoria.app
WEB_URL=https://www.savoria.app

# ─── Database (PostgreSQL) ──────────────────────────────────
# Use a managed PostgreSQL provider (Neon, Supabase, Railway, Render)
# Example (Neon): postgresql://user:pass@ep-xxx.region.aws.neon.tech/savoria?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/savoria?sslmode=require
# For connection pooling (Prisma + PgBouncer/Neon):
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/savoria?sslmode=require

# ─── Redis (Upstash or managed) ─────────────────────────────
# Example (Upstash): rediss://default:TOKEN@host:6379
REDIS_URL=rediss://default:TOKEN@HOST:6379

# ─── Auth / JWT ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_48_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_48_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=REPLACE_WITH_48_CHAR_RANDOM_HEX
BCRYPT_ROUNDS=12

# ─── Bootstrap admin (seed only) ────────────────────────────
ADMIN_EMAIL=admin@savoria.app
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Cloudflare Turnstile (bot protection) ──────────────────
CAPTCHA_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
CAPTCHA_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# ─── Google OAuth (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.savoria.app/api/auth/google/callback

# ─── AI / OpenAI-compatible provider ────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_PREMIUM=200

# ─── Email (Resend) ─────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=Savoria <noreply@savoria.app>

# ─── Storage (Cloudflare R2 / S3-compatible) ────────────────
# Production MUST use object storage, not local filesystem
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=savoria-media
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_PUBLIC_URL=https://media.savoria.app

# ─── Rate limits ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30

# ─── Feature flags ──────────────────────────────────────────
FEATURE_AI_CHAT_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
FEATURE_REGISTRATION_ENABLED=true

# ─── Observability ──────────────────────────────────────────
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN
LOG_LEVEL=info

# ─── Frontend (Vite) ────────────────────────────────────────
VITE_API_URL=https://api.savoria.app
VITE_APP_NAME=Savoria