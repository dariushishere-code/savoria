# ─── Core ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173

# ─── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://savoria:savoria@localhost:5432/savoria?schema=public
DIRECT_URL=postgresql://savoria:savoria@localhost:5432/savoria?schema=public

# ─── Redis (optional, used for rate limiting / sessions) ────
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ─────────────────────────────────────────────
# Generate strong random strings (min 32 chars) for production
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32ch!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=dev-cookie-secret-change-me-32chars!
BCRYPT_ROUNDS=12

# ─── Bootstrap admin (seed only) ────────────────────────────
ADMIN_EMAIL=admin@savoria.app
ADMIN_PASSWORD=ChangeMeAdmin123!

# ─── Cloudflare Turnstile (bot protection) ──────────────────
# Leave empty in local dev to skip captcha verification
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ─── Google OAuth (optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── AI / OpenAI-compatible provider ────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_DAILY_LIMIT_FREE=20
AI_DAILY_LIMIT_PREMIUM=200

# ─── Email (Resend or compatible) ───────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Savoria <noreply@savoria.app>

# ─── Storage (local or S3-compatible) ───────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Rate limits ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=30

# ─── Feature flags ──────────────────────────────────────────
FEATURE_AI_CHAT_ENABLED=true
FEATURE_COMMENTS_ENABLED=true
FEATURE_REGISTRATION_ENABLED=true

# ─── Observability ──────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Frontend (Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=Savoria
