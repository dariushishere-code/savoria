{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rootDirectory": "apps/web",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.savoria.app/api/:path*"
    }
  ]
}