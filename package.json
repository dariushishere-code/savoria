{
  "name": "savoria",
  "version": "1.0.0",
  "private": true,
  "description": "SAVORIA — Discover. Cook. Savor. Global recipe discovery platform with AI cooking assistant.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @savoria/web dev",
    "dev:api": "pnpm --filter @savoria/api dev",
    "dev:mobile": "pnpm --filter @savoria/mobile start",
    "build": "turbo run build",
    "build:web": "pnpm --filter @savoria/web build",
    "build:api": "pnpm --filter @savoria/api build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @savoria/database generate",
    "db:migrate": "pnpm --filter @savoria/database migrate",
    "db:migrate:deploy": "pnpm --filter @savoria/database migrate:deploy",
    "db:push": "pnpm --filter @savoria/database push",
    "db:seed": "pnpm --filter @savoria/database seed",
    "db:studio": "pnpm --filter @savoria/database studio",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "clean": "node scripts/clean.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "production:check": "node scripts/production-check.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
